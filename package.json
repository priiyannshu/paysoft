{
  "name": "paysoft",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "build:pwa": "astro build --root app/pwa",
    "deploy": "wrangler deploy",
    "pretest": "mkdir -p app/pwa/dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint app/",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply paysoft --local",
    "db:migrate:remote": "wrangler d1 migrations apply paysoft --remote"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/tailwind": "^6.0.2",
    "@hono/zod-validator": "^0.9.0",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@react-pdf/renderer": "^4.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.1",
    "hono": "^4.0.0",
    "lucia": "^3.2.2",
    "lucide-react": "^1.31.0",
    "oslo": "^1.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20240101.0",
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.2.18",
    "drizzle-kit": "^0.28.0",
    "drizzle-orm": "^0.36.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.0.0"
  }
}
