    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply paysoft --local",
    "db:migrate:remote": "wrangler d1 migrations apply paysoft --remote"
  },
  "dependencies": {
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@react-pdf/renderer": "^4.6.0",
    "hono": "^4.0.0",
    "lucia": "^3.2.2",
    "oslo": "^1.2.1",
    "react": "^19.2.8",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20240101.0",
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.2.18",
    "drizzle-kit": "^0.28.0",
    "drizzle-orm": "^0.36.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.0.0"
