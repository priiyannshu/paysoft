{
  "name": "paysoft",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "build:pwa": "echo 'placeholder — Astro build lands in Phase 4'",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
