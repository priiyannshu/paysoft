---
import '../styles/global.css';
import { Header } from '../components/Header';
import { Footer } from '../components/Footer';

interface Props {
  title?: string;
  currentPath?: string;
}

const { title = 'PaySoft v2 — Indian Payroll & HR Management', currentPath = '/' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Next-Generation Indian Payroll & HR Management Platform on Cloudflare Edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-100 text-slate-900 antialiased font-sans">
    <Header client:load currentPath={currentPath} />
    <main class="flex-1 pb-10">
      <slot />
    </main>
    <Footer client:load />
  </body>
</html>
